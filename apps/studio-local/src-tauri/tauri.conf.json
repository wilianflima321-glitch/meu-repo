{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aethel Studio Local",
  "version": "0.1.0",
  "identifier": "dev.aethel.studio.local",
  "build": {
    "beforeDevCommand": "npm --prefix ../../cloud-web-app/web run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Aethel Studio Local",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://aethel.dev https://*.aethel.dev wss://*.aethel.dev",
        "font-src": "'self' asset: data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:3000",
        "connect-src": "ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000 http://127.0.0.1:* ws://127.0.0.1:*",
        "font-src": "'self' data: http://localhost:3000",
        "img-src": "'self' blob: data: http://localhost:3000",
        "style-src": "'self' 'unsafe-inline' http://localhost:3000",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Native runtime shell for Aethel Studio",
    "longDescription": "Aethel Studio Local provides native runtime probes, job lanes, and local/cloud execution routing for large AI, game, film, app, and browser-operator work."
  }
}
