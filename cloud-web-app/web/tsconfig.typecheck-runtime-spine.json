{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "app/admin/**/*.tsx",
    "app/download/page.tsx",
    "app/studio/**/*.tsx",
    "components/admin/**/*.tsx",
    "components/agents/**/*.tsx",
    "components/labs/VRPreview.tsx",
    "components/studio/**/*.tsx",
    "components/viewport/**/*.tsx",
    "lib/admin/**/*.ts",
    "lib/studio/**/*.ts",
    "lib/studio-local/**/*.ts",
    "lib/runtime/**/*.ts",
    "types/**/*.d.ts",
    "lib/production/governed-runtime-jobs.ts",
    "lib/production/runtime-execution-evidence-package.ts",
    "lib/production/asset-quality-job-runner.ts",
    "lib/production/studio-local-cook-queue.ts",
    "app/api/projects/[id]/production-state/governed-job/route.ts",
    "app/api/projects/[id]/production-state/asset-quality-job/route.ts",
    "app/api/projects/[id]/production-state/studio-local-cook-job/route.ts",
    "lib/production/studio-local-cook-dispatch.ts",
    "app/api/projects/[id]/production-state/studio-local-cook-dispatch/route.ts",
    "app/api/projects/[id]/production-state/runtime-execution-evidence-package/route.ts",
    "app/api/projects/[id]/production-state/runtime-job-receipts/route.ts",
    "app/api/runtime/toolchain-readiness/route.ts",
    "app/api/runtime/best-market-internal-spine/route.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e/**/*",
    "__tests__/**/*"
  ]
}
