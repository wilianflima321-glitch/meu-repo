{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "app/admin/**/*.tsx",
    "app/download/page.tsx",
    "app/studio/**/*.tsx",
    "components/admin/**/*.tsx",
    "components/agents/**/*.tsx",
    "components/LivePreview.tsx",
    "components/SimpleMini3DPreview.tsx",
    "components/marketplace/AssetDetailPanel.tsx",
    "components/marketplace/AssetModelPreview.tsx",
    "components/studio/**/*.tsx",
    "components/viewport/**/*.tsx",
    "lib/admin/**/*.ts",
    "lib/studio/**/*.ts",
    "lib/studio-local/**/*.ts",
    "lib/runtime/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e/**/*",
    "__tests__/**/*"
  ]
}
