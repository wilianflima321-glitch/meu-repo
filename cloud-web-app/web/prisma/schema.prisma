// ============================================
// ARCADE - Published games (public showcase + play)
// ============================================

model PublishedGame {
  id          String   @id @default(cuid())
  // Stable, URL-safe identity for /arcade/[slug]
  slug        String   @unique

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title        String
  description  String?  @db.Text
  thumbnailUrl String?
  tags         String[] @default([])

  // Build/play wiring. A published game becomes playable once the web
  // ExportJob completes and a public play URL is available.
  exportJobId  String?  // ExportJob (platform: web) producing the playable bundle
  playUrl      String?  // public HTML5 play URL when the web build is ready

  /// Instant Play HTML URL — Law XV bake + demo-web-slice ready only (never zip theater).
  demoPlayUrl              String?
  /// Creator / catalog: no browser demo → Hub Desktop Exclusive.
  noWebDemo                Boolean  @default(false)
  /// Measured demo/cook bundle bytes for Compression Mandate (null = unknown / fail-closed).
  demoBundleBytes          Int?
  /// True only when measured ≤150MB evidence was stamped at publish (never invented).
  compressionMandatePassed Boolean  @default(false)

  // pending = published, web build not ready yet (honest "build pending" state)
  // building = export in progress; playable = play URL live; failed; unpublished
  status       String   @default("pending")
  visibility   String   @default("public") // public, unlisted, private
  plays        Int      @default(0)

  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// In-game marketplace listings (skins, weapons, cosmetics) sold for this
  /// specific game — see `MarketplaceItem.gameId` / OMNI-PLAN PILAR 5.
  marketplaceItems MarketplaceItem[]

  // One published listing per project (republish updates it).
  @@unique([projectId])
  @@index([authorId])
  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
}

// ============================================
// WORLD ENGINE — SPRINT V32
// Relational models for large-scale, streaming
// 3D worlds with AI-generated asset lineage.
// ============================================

/// Top-level world container. One Project may contain multiple World snapshots.
model World {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// Bounding box in world-space metres (JSON: {minX,minZ,maxX,maxZ})
  bounds      Json?

  /// Default biome applied to untagged regions
  defaultBiome String?

  /// Overall style embedding centroid (128-d array serialised as JSON float[])
  styleEmbedding Json?

  /// "active" | "archived" | "template"
  status      String   @default("active")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    WorldVersion[]
  regions     WorldRegion[]
  assets      GeneratedAsset[]
  branches    WorldBranch[]

  @@index([projectId])
  @@index([status])
}

/// Immutable snapshot of a World at a point in time.
/// Supports versioned diffs (binary patch) for rollback and collaboration.
model WorldVersion {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  /// Human-readable label e.g. "v1.3 — Darkwood region complete"
  label       String?

  /// Base version this one was built upon (null = first snapshot)
  parentId    String?
  parent      WorldVersion? @relation("WorldVersionTree", fields: [parentId], references: [id])
  children    WorldVersion[] @relation("WorldVersionTree")

  /// Binary diff from parent (stored as base64 or S3 key reference)
  diffPayload  String?

  /// Full scene JSON snapshot (used when diff chain is too long to replay)
  snapshotJson Json?

  createdBy   String
  createdAt   DateTime @default(now())

  @@index([worldId])
  @@index([parentId])
  @@index([createdAt])
}

/// A named spatial subdivision of a World.
/// Enables streaming — only loaded regions are in memory.
model WorldRegion {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  name        String
  /// Biome identifier (matches SoundscapeLayer biomeTags and StyleEmbedding tags)
  biome       String?

  /// Axis-aligned bounding box: {minX, minZ, maxX, maxZ} in world metres
  bounds      Json

  /// LOD configuration: {near, mid, far} polygon budget multipliers
  lodConfig   Json?

  /// "unloaded" | "loading" | "loaded" | "streaming"
  loadStatus  String   @default("unloaded")

  /// Compressed scene payload (msgpack / gltf binary, base64 or S3 key)
  scenePayload String?

  assets      GeneratedAsset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
  @@index([biome])
  @@index([loadStatus])
}

/// Tracks every AI-generated asset: its prompt, model, parameters, and
/// quality score — the complete prompt→mesh genealogy required by the
/// Generation Inspector.
model GeneratedAsset {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  regionId    String?
  region      WorldRegion? @relation(fields: [regionId], references: [id])

  /// Human-readable asset name
  name        String

  /// "mesh" | "material" | "texture" | "audio" | "narrative"
  assetType   String

  /// Source prompt used for generation
  prompt      String

  /// Negative prompt / exclusions
  negativePrompt String?

  /// Which AI model produced this (e.g. "meshy-v4", "tripo-v2", "sd-xl")
  modelUsed   String

  /// Generation hyper-parameters (JSON: temperature, steps, guidance_scale…)
  parameters  Json?

  /// Cosine-comparable 128-d style embedding (JSON float[])
  styleEmbedding Json?

  /// 0–1 coherence score from ReflectionLoop
  qualityScore Float  @default(0)

  /// S3 / CDN key for the generated file
  storageKey  String?

  /// Content hash (SHA-256) of the generated file for deduplication
  contentHash String?

  /// Asset this was derived from (remix / variation lineage)
  parentAssetId String?
  parentAsset   GeneratedAsset?  @relation("AssetLineage", fields: [parentAssetId], references: [id])
  childAssets   GeneratedAsset[] @relation("AssetLineage")

  /// Generation duration in milliseconds
  durationMs  Int?

  /// Credit cost charged for this generation
  costCredits Float  @default(0)

  /// Moderation status: "pending" | "approved" | "flagged" | "rejected"
  moderationStatus String @default("pending")

  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
  @@index([regionId])
  @@index([assetType])
  @@index([qualityScore])
  @@index([moderationStatus])
  @@index([contentHash])
  @@index([createdBy])
}

/// Project-level style embedding registry.
/// Enables fast cosine nearest-neighbour lookups without reading all assets.
model StyleEmbedding {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Links to a specific generated asset (optional — embeddings can be standalone)
  assetId     String?

  /// Biome / style tag bucket
  tag         String

  /// 128-d cosine-comparable vector (JSON float[])
  embedding   Json

  /// Source prompt that produced this embedding
  prompt      String?

  /// 0–1 quality score at time of indexing
  qualityScore Float  @default(0)

  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([tag])
  @@index([qualityScore])
}

// ============================================
// F.1 / Law II — GameSave (cloud sync citizen)
// Durable disk path remains under `.aethel/liveops/game-saves`.
// Payload may live inline (Json) or as R2 CAS via blobHash/blobKey.
// ============================================

model GameSave {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId         String
  slotIndex      Int
  name           String
  /// Inline JSON payload when R2 CAS not used (typical ≤2 MiB).
  payload        Json?
  /// SHA-256 of canonical payload (also used as CAS content address).
  checksum       String
  /// Content-address hash for CAS (usually equals checksum).
  blobHash       String?
  /// Optional R2/S3 object key when payload offloaded to blob store.
  r2Key          String?
  clientPlatform String?
  revisedAt      DateTime
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, gameId, slotIndex])
  @@index([userId, gameId])
  @@index([blobHash])
  @@index([revisedAt])
}

/// Git-style branch for collaborative world editing.
/// Enables multi-creator parallel work with merge conflict resolution.
model WorldBranch {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// SHA of the WorldVersion this branch was created from
  baseVersionId String?

  /// "open" | "merged" | "abandoned"
  status      String   @default("open")

  /// JSON diff summary produced by world-branch.ts for the merge review UI
  mergeSummary Json?

  createdBy   String
  mergedBy    String?
  mergedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
  @@index([status])
  @@index([createdBy])
}
