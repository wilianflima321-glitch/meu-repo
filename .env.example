# ==============================================================================
# AETHEL ENGINE - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit real secrets to the repository.
# ==============================================================================

# ==============================================================================
# DATABASE (Required)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aethel"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aethel

# ==============================================================================
# REDIS (Required for caching/rate-limiting)
# ==============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# ==============================================================================
# AUTHENTICATION & SECURITY (Required)
# ==============================================================================
JWT_SECRET=GENERATE_A_RANDOM_256_BIT_SECRET
CSRF_SECRET=GENERATE_ANOTHER_RANDOM_256_BIT_SECRET
NEXTAUTH_SECRET=GENERATE_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ==============================================================================
# APP CONFIGURATION (Required)
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
AETHEL_BASE_URL=http://localhost:3000
NODE_ENV=development

# ==============================================================================
# AI PROVIDERS (At least one required, or use DEMO_MODE)
# ==============================================================================
AETHEL_AI_DEMO_MODE=true
OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...

# ==============================================================================
# STRIPE / BILLING (Required for revenue)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs - Create these in Stripe Dashboard -> Products
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ==============================================================================
# STUDIO LOCAL RUNTIME (Required for trusted local/cloud sync in production)
# ==============================================================================
# Generate a random 256-bit secret. When set, /api/runtime/local-capabilities
# requires HMAC-signed Studio Local api-sync probes. Leave unset only for local dev.
AETHEL_STUDIO_LOCAL_SYNC_SECRET=GENERATE_A_RANDOM_256_BIT_SECRET

# ==============================================================================
# VIEWPORT RENDER BACKEND (Required for render:viewport workers)
# ==============================================================================
# Worker calls `${AETHEL_RENDER_BACKEND_ENDPOINT}/viewport/render`.
# For the built-in Next.js renderer, use http://localhost:3000/api/runtime.
# This internal renderer creates real scene preview artifacts and reports; final
# MP4/video outputs still require a native/cloud media renderer.
AETHEL_RENDER_BACKEND_ENDPOINT=http://localhost:3000/api/runtime
AETHEL_RENDER_BACKEND_TOKEN=GENERATE_A_RANDOM_256_BIT_SECRET
AETHEL_RENDER_ARTIFACT_ROOT=.aethel/runtime-artifacts

# ==============================================================================
# PREVIEW SANDBOX (Required for live preview)
# ==============================================================================
AETHEL_PREVIEW_PROVIDER=e2b
AETHEL_PREVIEW_PROVISION_TOKEN=e2b_...
AETHEL_PREVIEW_PROVISION_ENDPOINT=https://api.e2b.dev
# Alternative: webcontainers (browser-side, no token needed)
# AETHEL_PREVIEW_PROVIDER=webcontainers

# ==============================================================================
# OBSERVABILITY (Optional but recommended)
# ==============================================================================
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=sntrys_...

# ==============================================================================
# STORAGE (AWS S3 / MinIO)
# ==============================================================================
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_BUCKET_NAME=aethel-storage
AWS_ENDPOINT=http://localhost:9000

# ==============================================================================
# OPTIONAL AI PROVIDERS
# ==============================================================================
# ELEVENLABS_API_KEY=...
# MESHY_API_KEY=...
# SUNO_API_KEY=...
